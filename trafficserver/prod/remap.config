# HTTP -> HTTPS 리다이렉트
redirect http://kokomen.kr/ https://kokomen.kr/

# 프론트엔드: kokomen.kr -> kokomen-client-blue:3000
# blue-green-deploy.sh 스크립트가 remap.config.tmpl 기반으로 이 파일을 자동 생성합니다
map https://kokomen.kr/ http://kokomen-client-blue:3000/ \
  @plugin=header_rewrite.so @pparam=/opt/etc/trafficserver/header_rewrite/security-headers.conf \
  @plugin=header_rewrite.so @pparam=/opt/etc/trafficserver/header_rewrite/proxy-headers.conf
reverse_map http://kokomen-client-blue:3000/ https://kokomen.kr/
